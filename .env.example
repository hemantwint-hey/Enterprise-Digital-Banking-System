# =========================================================================
# Enterprise Digital Banking System - Environment Configuration Template
# Copy this file to .env and customize values for local development
# =========================================================================

# Database Configuration (MySQL)
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Security
# Secret must be at least 256 bits (32 bytes) long (e.g. generated base64 string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis Configuration (defaults to localhost:6379 in application.properties)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
